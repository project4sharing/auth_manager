# Copy to .env and fill in. `adk web` loads this automatically.

# --- GCP / Gemini ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- 2LO demo wiring ---
# Resource name printed by scripts/2_create_auth_provider.sh
# (use .../connectors/NAME instead if you used the older Connectors API)
ORDERS_2LO_AUTH_PROVIDER=projects/your-project-id/locations/us-central1/authProviders/mock-orders-2lo

# Cloud Run URL printed by scripts/1_deploy_mock_oauth.sh
ORDERS_API_BASE_URL=https://mock-2lo-oauth-XXXX-uc.a.run.app
